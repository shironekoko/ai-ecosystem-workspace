# ─────────────────────────────────────────────
# .env.docker — Environment Variables สำหรับ Docker Compose
# ─────────────────────────────────────────────
# ความแตกต่างจาก .env ปกติ:
#   .env ใช้ localhost (รันบน Host เครื่อง)
#   .env.docker ใช้ชื่อ Service (Container ใช้ DNS ของ Docker Network)
#
# เช่น localhost:5433 → postgres:5432
#      localhost:6379  → redis:6379
#      localhost:9000  → minio:9000

# ── Database (ชื่อ service คือ "postgres" ใน compose.yml) ──
DATABASE_URL=postgresql://db_user:db_password@postgres:5432/label_studio_db

# ── Label Studio ──
LABEL_STUDIO_URL=http://label-studio:8080
LABEL_STUDIO_API_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJ0b2tlbl90eXBlIjoicmVmcmVzaCIsImV4cCI6ODA5MTY2MjAxMywiaWF0IjoxNzg0NDYyMDEzLCJqdGkiOiJhOTgwZGUxZmJjN2Y0MGRjOWMxZGI0ZmI3ZDczMTRhNiIsInVzZXJfaWQiOiIyIn0.Lc0e3u8wb22l5tCAvAJr_OGtBLpU-3pRSN6EblXv7Yo

# ── Redis (ชื่อ service คือ "redis" ใน compose.yml) ──
REDIS_URL=redis://redis:6379/0

# ── MinIO (ชื่อ service คือ "minio" ใน compose.yml) ──
MINIO_ENDPOINT=minio:9000
MINIO_ACCESS_KEY=miniouser
MINIO_SECRET_KEY=miniopassword
MINIO_SECURE=False
